# 复制为 .env 后按需修改。

# ---- 数据库 ----
DB_PATH=papers.db

# ---- AI 模式：local（离线）| cloud（OpenAI 格式 API）----
AI_MODE=local

# ---- 本地模式 ----
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2
# sentence-transformers 不可用时是否降级为纯 TF-IDF（完全离线）
ALLOW_TFIDF_FALLBACK=true

# ---- 云端模式（OpenAI API 格式）----
# 兼容 OpenAI / DeepSeek / 本地 Ollama / vLLM 等任意 OpenAI 兼容端点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-max
EMBED_MODEL=text-embedding-v4

# ---- 分析参数 ----
SIMILARITY_THRESHOLD=0.45
TFIDF_SIMILARITY_THRESHOLD=0.18
TOP_K_SIMILAR=5
NUM_CLUSTERS=3
MAX_TAGS_PER_PAPER=5
